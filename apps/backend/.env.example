# Backend Environment Configuration
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (Database & Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Gemini API (Free Tier on Google AI Studio)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_REASONING_MODEL=gemini-2.0-flash

# Cloudflare R2 Storage (Only Storage Provider)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_PUBLIC_ASSET_BUCKET=eureka-public-assets
R2_PUBLIC_ASSET_URL=https://assets.yourdomain.com
R2_PRIVATE_OUTPUT_BUCKET=eureka-private-outputs

# Safety Bounds
AI_MAX_TOOL_CALLS=25
AI_RUN_TIMEOUT_SECONDS=180
