# ==============================================================================
# AI Electronics Project Builder (Eureka) - Unified Environment Configuration
# ==============================================================================
# Copy this file to .env at the project root

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Auth)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Frontend Public Variables (Next.js client-accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.yourdomain.com

# ------------------------------------------------------------------------------
# 2. AI Model Provider (Google Gemini API Only - Free Tier for MVP)
# ------------------------------------------------------------------------------
# Get your FREE API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Model Routing Choices (Gemini Models on Google AI Studio Free Tier)
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_REASONING_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 3. Object Storage (Cloudflare R2 Only)
# ------------------------------------------------------------------------------
# Cloudflare R2 S3-Compatible Storage
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# Buckets
R2_PUBLIC_ASSET_BUCKET=eureka-public-assets
R2_PUBLIC_ASSET_URL=https://assets.yourdomain.com
R2_PRIVATE_OUTPUT_BUCKET=eureka-private-outputs

# ------------------------------------------------------------------------------
# 4. Backend Service Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# AI Run Safety Bounds
AI_MAX_TOOL_CALLS=25
AI_RUN_TIMEOUT_SECONDS=180
